{
  "manifest_version": 3,
  "name": "Browser Automation Learning Demo",
  "version": "1.0.1",
  "description": "浏览器自动化学习演示：自动输入、点击、定时与动态元素处理",
  "author": "max",
  "action": {
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "64": "icon.png",
      "128": "icon.png"
    },
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "64": "icon.png",
    "128": "icon.png"
  },

  "permissions": ["storage"],

  "content_scripts": [
    {
      "matches": ["https://gcstop.co.kr/practice/apply/korea*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
